# Copy to .env and adjust.
PORT=8080

# Repository the running container follows. New commits on GIT_BRANCH are deployed automatically.
# Private repo: https://<user>:<token>@github.com/<user>/chassette.git
GIT_REPO=https://github.com/<user>/chassette.git
GIT_BRANCH=main
GIT_POLL_SECONDS=60

# Optional webhook secret for instant deploys (POST https://your-host/api/hook).
WEBHOOK_SECRET=

# Feed settings
REFRESH_MINUTES=10
ITEMS_PER_SOURCE=2
MAX_AGE_HOURS=72
